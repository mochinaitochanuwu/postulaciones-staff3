NODE_ENV=development
PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
DB_PATH=./data/staff.sqlite
# ID de tu cuenta personal (no el Client ID de la aplicación).
ADMIN_DISCORD_ID=
ADMIN_NAME=Administradora
# Bot > Token en Discord Developer Portal; no es el Client Secret de OAuth.
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_64_CARACTERES
# Solo Railway: activar al desplegar en su proxy. Local: false.
TRUST_PROXY=false
# Aplicación OAuth2 en Discord (distinta del webhook).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
